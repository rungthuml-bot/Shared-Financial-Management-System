// Prisma Schema for Installment Manager
// Production-ready schema for PostgreSQL with precise Decimal currency handling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Authentication Models (Better Auth Compatible)
// -------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  // Domain Relations
  ownedInstallments    Installment[]        @relation("InstallmentOwner")
  partnerInstallments  Installment[]        @relation("InstallmentPartner")
  paidInstallments     InstallmentPayment[] @relation("PayerUser")
  paymentSplits        PaymentSplit[]       @relation("SplitUser")
  settlementsOwed      Settlement[]         @relation("SettlementFromUser")
  settlementsReceiving Settlement[]         @relation("SettlementToUser")
  notifications        Notification[]
  customProviders      Provider[]           @relation("ProviderCreator")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum OwnershipType {
  PERSONAL
  SHARED
}

enum SplitType {
  NONE
  EQUAL
  PERCENTAGE
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
}

enum SettlementStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum NotificationType {
  PAYMENT_DUE
  PAYMENT_OVERDUE
  SETTLEMENT
  SYSTEM
}

// -------------------------------------------------------------
// Domain Models
// -------------------------------------------------------------

model Provider {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // shopee, tiktok-shop, lazada, credit-card, truemoney, mobile, other
  icon        String?  // lucide icon identifier e.g. "shopping-bag", "credit-card"
  color       String?  // brand color token e.g. "#EE4D2D"
  active      Boolean  @default(true)
  isCustom    Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("ProviderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installments Installment[]

  @@index([active])
  @@map("providers")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // shopping, electronics, mobile, home, education, transportation, subscription, other
  icon      String?  // lucide icon identifier
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments Installment[]

  @@index([active])
  @@map("categories")
}

model Installment {
  id                  String            @id @default(cuid())
  ownerId             String
  owner               User              @relation("InstallmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  partnerId           String?
  partner             User?             @relation("InstallmentPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  providerId          String
  provider            Provider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  
  categoryId          String?
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  name                String
  description         String?
  
  // Precise currency fields using Decimal(12, 2)
  totalAmount         Decimal           @db.Decimal(12, 2)
  downPayment         Decimal           @default(0.00) @db.Decimal(12, 2)
  installmentAmount   Decimal           @db.Decimal(12, 2)
  totalInstallments   Int
  
  startDate           DateTime
  dueDay              Int               // 1-31
  
  ownershipType       OwnershipType     @default(PERSONAL)
  splitType           SplitType         @default(NONE)
  
  // Percentage distribution for Shared installments
  userSharePercent    Decimal           @default(100.00) @db.Decimal(5, 2)
  partnerSharePercent Decimal           @default(0.00) @db.Decimal(5, 2)
  
  status              InstallmentStatus @default(ACTIVE)
  note                String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  payments            InstallmentPayment[]

  @@index([ownerId])
  @@index([partnerId])
  @@index([providerId])
  @@index([categoryId])
  @@index([status])
  @@index([startDate])
  @@map("installments")
}

model InstallmentPayment {
  id                String        @id @default(cuid())
  installmentId     String
  installment       Installment   @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(UPCOMING)
  
  paidAt            DateTime?
  payerId           String?
  payer             User?         @relation("PayerUser", fields: [payerId], references: [id], onDelete: SetNull)
  
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  splits            PaymentSplit[]

  @@unique([installmentId, installmentNumber])
  @@index([installmentId])
  @@index([dueDate])
  @@index([status])
  @@map("installment_payments")
}

model PaymentSplit {
  id            String             @id @default(cuid())
  paymentId     String
  payment       InstallmentPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User               @relation("SplitUser", fields: [userId], references: [id], onDelete: Cascade)
  
  percentage    Decimal            @db.Decimal(5, 2) // e.g. 50.00, 70.00
  amount        Decimal            @db.Decimal(12, 2) // e.g. 500.00, 700.00
  status        PaymentStatus      @default(UPCOMING)
  paidAt        DateTime?
  
  // Tracks who actually fronted the money for settlement calculation
  paidByUserId  String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([paymentId, userId])
  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@map("payment_splits")
}

model Settlement {
  id          String           @id @default(cuid())
  fromUserId  String
  fromUser    User             @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  
  toUserId    String
  toUser      User             @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  
  amount      Decimal          @db.Decimal(12, 2)
  status      SettlementStatus @default(PENDING)
  note        String?
  settledAt   DateTime?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@map("settlements")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  readAt    DateTime?

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}
